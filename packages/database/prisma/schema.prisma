generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CampusStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

/**
 * |--------------------------------------------------------------------------
 * | SCHOOL TENANCY
 * |--------------------------------------------------------------------------
 */

model School {
  id String @id @default(uuid())

  name String
  code String @unique

  email   String?
  phone   String?
  address String?
  logoUrl String?

  status SchoolStatus @default(ACTIVE)

  settings SchoolSettings?

  campuses Campus[]

  users User[]

  sessions AcademicSession[]

  classLevels ClassLevel[]

  subjects Subject[]

  students Student[]

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

model SchoolSettings {
  id String @id @default(uuid())

  schoolId String @unique

  school School @relation(fields: [schoolId], references: [id])

  country String @default("Nigeria")

  currency String @default("NGN")

  timezone String @default("Africa/Lagos")

  gradingSystem String @default("PERCENTAGE")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("school_settings")
}

model Campus {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  name String

  code String

  address String?

  status CampusStatus @default(ACTIVE)

  users User[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@map("campuses")
}

/**
 * |--------------------------------------------------------------------------
 * | USER MANAGEMENT + RBAC
 * |--------------------------------------------------------------------------
 */

model User {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  campusId String?

  campus Campus? @relation(fields: [campusId], references: [id])

  firstName String

  lastName String

  email String

  phone String?

  passwordHash String

  status UserStatus @default(ACTIVE)

  roles UserRole[]

  auditLogs AuditLog[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@map("users")
}

model Role {
  id String @id @default(uuid())

  name String @unique

  users UserRole[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  name String @unique

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id])

  roleId String

  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid())

  roleId String

  role Role @relation(fields: [roleId], references: [id])

  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  userId String?

  user User? @relation(fields: [userId], references: [id])

  action String

  entity String

  entityId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/**
 * |--------------------------------------------------------------------------
 * | ACADEMIC CALENDAR
 * |--------------------------------------------------------------------------
 */

model AcademicSession {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  name String

  startDate DateTime

  endDate DateTime

  isCurrent Boolean @default(false)

  terms AcademicTerm[]

  enrollments Enrollment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("academic_sessions")
}

model AcademicTerm {
  id String @id @default(uuid())

  sessionId String

  session AcademicSession @relation(fields: [sessionId], references: [id])

  name String

  startDate DateTime

  endDate DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("academic_terms")
}

/**
 * |--------------------------------------------------------------------------
 * | CLASS MANAGEMENT
 * |--------------------------------------------------------------------------
 */

model ClassLevel {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  name String

  order Int

  arms ClassArm[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@map("class_levels")
}

model ClassArm {
  id String @id @default(uuid())

  classLevelId String

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id])

  name String

  code String

  enrollments Enrollment[]

  subjects ClassSubject[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([classLevelId, code])
  @@map("class_arms")
}

/**
 * |--------------------------------------------------------------------------
 * | SUBJECT MANAGEMENT
 * |--------------------------------------------------------------------------
 */

model Subject {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  name String

  code String

  isCore Boolean @default(false)

  classSubjects ClassSubject[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id String @id @default(uuid())

  classArmId String

  classArm ClassArm @relation(fields: [classArmId], references: [id])

  subjectId String

  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classArmId, subjectId])
  @@map("class_subjects")
}

/**
 * |--------------------------------------------------------------------------
 * | STUDENT MANAGEMENT
 * |--------------------------------------------------------------------------
 */

model Student {
  id String @id @default(uuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id])

  studentNumber String

  firstName String

  middleName String?

  lastName String

  dateOfBirth DateTime?

  gender Gender

  enrollments Enrollment[]

  guardians StudentGuardian[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentNumber])
  @@map("students")
}

model Guardian {
  id String @id @default(uuid())

  firstName String

  lastName String

  phone String

  email String?

  students StudentGuardian[]

  createdAt DateTime @default(now())

  @@map("guardians")
}

model StudentGuardian {
  id String @id @default(uuid())

  studentId String

  student Student @relation(fields: [studentId], references: [id])

  guardianId String

  guardian Guardian @relation(fields: [guardianId], references: [id])

  relationship String

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model Enrollment {
  id String @id @default(uuid())

  studentId String

  student Student @relation(fields: [studentId], references: [id])

  classArmId String

  classArm ClassArm @relation(fields: [classArmId], references: [id])

  sessionId String

  session AcademicSession @relation(fields: [sessionId], references: [id])

  status EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  @@unique([studentId, sessionId])
  @@map("enrollments")
}
